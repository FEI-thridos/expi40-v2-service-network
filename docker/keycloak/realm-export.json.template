{
  "id": "${KEYCLOAK_REALM}",
  "realm": "${KEYCLOAK_REALM}",
  "enabled": true,
  "clients": [
    {
      "clientId": "${KEYCLOAK_CLIENT_ID}",
      "rootUrl": "https://ui.${DUCKDNS_SUBDOMAIN}.duckdns.org",
      "redirectUris": ["https://ui.${DUCKDNS_SUBDOMAIN}.duckdns.org/*"],
      "webOrigins": ["https://ui.${DUCKDNS_SUBDOMAIN}.duckdns.org"],
