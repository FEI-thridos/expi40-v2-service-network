  ],
  "users": [
    {
      "username": "${KEYCLOAK_TEST_USER}",
      "email": "testuser@test.mail",
      "firstName": "Test",
      "lastName": "User",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_TEST_USER_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
