[[outputs.influxdb_v2]]
## Data are available in basyx docker-compose
## in influx-db service part

## Combination of 'container_name' and default InfluxDB HTTP API - 8086
## Port 9999 was used with InfluxDB v1
urls=["http://influxdb:8086"]

## Authentication token
token="${INFLUX_TOKEN}"

## Organization to write data to; must exist
organization="${INFLUX_ORG}"

## Destination bucket to write into
bucket="${INFLUX_BUCKET}"

[[inputs.mqtt_consumer]]

## MQTT broker URLs to be used. The format should be scheme://host:port,
## schema can be tcp, ssl, or ws.
servers = ["tcp://mosquitto:1883"]

## Topics that will be subscribed to.
topics = [
  "sm-repository/#"
]

# Username and password to connect MQTT server.
username = "${MOSQUITTO_ADMIN_USER}"
password = "${MOSQUITTO_ADMIN_PASSWORD}"
  
## Data format to consume.
## Each data format has its own unique set of configuration options, read
## more about them here:
## https://github.com/influxdata/telegraf/blob/master/docs/DATA_FORMATS_INPUT.md
data_format = "json"

## Store `idShort` as a tag (tags must be strings)
tag_keys = ["idShort"]

## Extract `value`
json_string_fields = ["value"]